rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
        allow read, write: if request.auth != null;
    }

    // More specific rules can be added here, but the wildcard above allows
    // all authenticated access for the demo.

    // Example of more specific rules that could be used:
